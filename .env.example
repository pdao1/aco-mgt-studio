# Required by the API server
DATABASE_URL=postgresql://aco_studio:local-development-only@127.0.0.1:55432/aco_studio
MAILBOX_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
SESSION_SECRET=replace-with-a-different-long-random-secret
PORTAL_SECRET=replace-with-a-third-long-random-secret
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_DUE_DAYS=7
SERVICE_SERIAL=replace-with-a-beta-serial-key
SUPER_ADMIN_SERIAL=

# Shared Discord-first sign-in (identify scope; no bot token needed)
# Blank URI derives APP_ORIGIN/oauth/discord. Register the exact URL in Discord.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=

# Whop checkout, licensing, and automatic provisioning. Add both existing
# pricing plan IDs to enable embedded checkout for both products.
# Pin webhook payloads to v1 / 2026-09-15. See docs/discord-whop-setup.md.
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=
WHOP_ACCOUNT_ID=biz_1HjUYXgisSyf7z
WHOP_SOLO_PRODUCT_ID=prod_3mqbBwetOGv5G
WHOP_ACO_PRODUCT_ID=prod_SiiEh8TDBF2nk
# Existing pricing plan IDs from Whop > Checkout links > plan details.
WHOP_SOLO_PLAN_ID=
WHOP_ACO_PLAN_ID=
WHOP_SOLO_MAILBOX_LIMIT=2

# Optional invoice notifications (leave blank to disable SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFICATION_SELLER_EMAIL=

# Optional Venmo business payment URL (configured per workspace in the app)
VENMO_PAYMENT_URL=

# Optional low-cost AI item review (server-side only; leave blank for deterministic-only mode)
OPENAI_KEY=
OPENAI_MODEL=gpt-5-nano
OPENAI_MAX_REVIEWS_PER_SYNC=25

# Optional carrier tracking APIs (server-side only; access/fees depend on provider)
# See docs/tracking-setup.md, especially USPS third-party authorization requirements.
TRACKING_ENVIRONMENT=production
USPS_CLIENT_ID=
USPS_CLIENT_SECRET=
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
UPS_TRANSACTION_SRC=ordertracker-pro
FEDEX_API_KEY=
FEDEX_SECRET_KEY=
FEDEX_ACCOUNT_NUMBER=
TRACKING_SYNC_INTERVAL_MINUTES=30
TRACKING_MAX_SHIPMENTS_PER_SYNC=100

# Workspace and server settings
# Legacy installations only: one-time import, never overrides saved settings/passwords.
# New companies create their workspace in the app after entering SERVICE_SERIAL.
OPERATOR_PASSWORD=
WORKSPACE_NAME=Order Tracker Pro
WORKSPACE_SLUG=default
PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
SYNC_INTERVAL_MINUTES=5
SYNC_MAX_MESSAGES=500
NODE_ENV=development
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=55432
