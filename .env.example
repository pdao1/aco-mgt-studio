# Required by the API server
DATABASE_URL=postgresql://aco_studio:local-development-only@127.0.0.1:55432/aco_studio
MAILBOX_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
OPERATOR_PASSWORD=replace-with-a-long-operator-password
SESSION_SECRET=replace-with-a-different-long-random-secret
PORTAL_SECRET=replace-with-a-third-long-random-secret
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_DUE_DAYS=7
SERVICE_SERIAL=replace-with-a-beta-serial-key
SUPER_ADMIN_SERIAL=

# Optional invoice notifications (leave blank to disable SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFICATION_SELLER_EMAIL=

# Optional Venmo business payment URL (configured per workspace in the app)
VENMO_PAYMENT_URL=

# Optional low-cost AI item review (server-side only; leave blank for deterministic-only mode)
OPENAI_KEY=
OPENAI_MODEL=gpt-5-nano
OPENAI_MAX_REVIEWS_PER_SYNC=25

# Workspace and server settings
WORKSPACE_NAME=ACO Studio
WORKSPACE_SLUG=default
PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
SYNC_INTERVAL_MINUTES=5
SYNC_MAX_MESSAGES=500
NODE_ENV=development
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=55432
